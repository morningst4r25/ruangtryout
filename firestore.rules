rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{attemptId} {
      allow read: if true;

      // Guest submission is intentionally allowed, but the shape and ranges are constrained.
      // For tamper-proof scoring, move score verification to a trusted backend/Cloud Function.
      allow create: if
        request.resource.data.keys().hasOnly([
          'name','score','percentage','category','mode','correctAnswers',
          'answered','totalQuestions','attemptId','timestamp'
        ]) &&
        request.resource.data.attemptId == attemptId &&
        request.resource.data.attemptId.size() <= 64 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 40 &&
        request.resource.data.score is int &&
        request.resource.data.score >= 0 && request.resource.data.score <= 100 &&
        request.resource.data.percentage == request.resource.data.score &&
        request.resource.data.category in ['CPNS','UTBK'] &&
        request.resource.data.mode == 'full' &&
        request.resource.data.correctAnswers is int &&
        request.resource.data.answered is int &&
        request.resource.data.totalQuestions is int &&
        request.resource.data.totalQuestions >= 1 && request.resource.data.totalQuestions <= 120 &&
        request.resource.data.correctAnswers >= 0 && request.resource.data.correctAnswers <= request.resource.data.totalQuestions &&
        request.resource.data.answered >= 0 && request.resource.data.answered <= request.resource.data.totalQuestions &&
        request.resource.data.timestamp == request.time;

      allow update, delete: if false;
    }
  }
}
