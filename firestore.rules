rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // LEADERBOARD
    // =====================================================
    match /leaderboard/{attemptId} {
      allow read: if true;

      // Guest submission is allowed only for full tryout results.
      // Client-side scoring is still not tamper-proof; move score
      // verification to a trusted backend/Cloud Function when needed.
      allow create: if
        request.resource.data.keys().hasOnly([
          'name','score','percentage','category','mode','correctAnswers',
          'answered','totalQuestions','attemptId','timestamp'
        ]) &&
        request.resource.data.attemptId == attemptId &&
        request.resource.data.attemptId is string &&
        request.resource.data.attemptId.size() >= 8 &&
        request.resource.data.attemptId.size() <= 64 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 40 &&
        request.resource.data.score is int &&
        request.resource.data.score >= 0 && request.resource.data.score <= 100 &&
        request.resource.data.percentage == request.resource.data.score &&
        request.resource.data.category in ['CPNS','UTBK'] &&
        request.resource.data.mode == 'full' &&
        request.resource.data.correctAnswers is int &&
        request.resource.data.answered is int &&
        request.resource.data.totalQuestions is int &&
        request.resource.data.totalQuestions >= 1 && request.resource.data.totalQuestions <= 120 &&
        request.resource.data.correctAnswers >= 0 &&
        request.resource.data.correctAnswers <= request.resource.data.totalQuestions &&
        request.resource.data.answered >= 0 &&
        request.resource.data.answered <= request.resource.data.totalQuestions &&
        request.resource.data.timestamp == request.time;

      allow update, delete: if false;
    }

    // =====================================================
    // VISITOR IDENTITY MARKERS
    // Anonymous random browser IDs only. No PII is stored.
    // Direct get is needed by the browser transaction; listing is blocked.
    // =====================================================
    match /siteVisitors/{visitorId} {
      allow get: if true;
      allow list: if false;

      allow create: if
        visitorId.matches('^[A-Za-z0-9_-]{16,64}$') &&
        request.resource.data.keys().hasOnly(['createdAt','firstDay']) &&
        request.resource.data.firstDay is string &&
        request.resource.data.firstDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // One marker per browser per WIB calendar day.
    match /siteVisitorDays/{dayVisitId} {
      allow get: if true;
      allow list: if false;

      allow create: if
        dayVisitId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[A-Za-z0-9_-]{16,64}$') &&
        request.resource.data.keys().hasOnly(['visitorId','day','createdAt']) &&
        request.resource.data.visitorId is string &&
        request.resource.data.visitorId.matches('^[A-Za-z0-9_-]{16,64}$') &&
        request.resource.data.day is string &&
        request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        dayVisitId == request.resource.data.day + '_' + request.resource.data.visitorId &&
        request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // =====================================================
    // PUBLIC AGGREGATE COUNTERS
    // Counters may only move upward by exactly 1 and must reference
    // a marker created in the same atomic transaction.
    // =====================================================
    match /siteStats/global {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(['totalVisitors','lastVisitorId','updatedAt']) &&
        request.resource.data.totalVisitors == 1 &&
        request.resource.data.lastVisitorId is string &&
        request.resource.data.lastVisitorId.matches('^[A-Za-z0-9_-]{16,64}$') &&
        request.resource.data.updatedAt == request.time &&
        getAfter(/databases/$(database)/documents/siteVisitors/$(request.resource.data.lastVisitorId)).data.createdAt == request.time;

      allow update: if
        request.resource.data.keys().hasOnly(['totalVisitors','lastVisitorId','updatedAt']) &&
        request.resource.data.totalVisitors == resource.data.totalVisitors + 1 &&
        request.resource.data.lastVisitorId is string &&
        request.resource.data.lastVisitorId != resource.data.lastVisitorId &&
        request.resource.data.updatedAt == request.time &&
        getAfter(/databases/$(database)/documents/siteVisitors/$(request.resource.data.lastVisitorId)).data.createdAt == request.time;

      allow delete: if false;
    }

    match /siteStats/{dailyId} {
      allow read: if dailyId.matches('^daily_[0-9]{4}-[0-9]{2}-[0-9]{2}$');

      allow create: if
        dailyId.matches('^daily_[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.keys().hasOnly(['visitors','day','lastDayVisitId','updatedAt']) &&
        request.resource.data.visitors == 1 &&
        request.resource.data.day is string &&
        dailyId == 'daily_' + request.resource.data.day &&
        request.resource.data.lastDayVisitId is string &&
        request.resource.data.lastDayVisitId == request.resource.data.day + '_' +
          getAfter(/databases/$(database)/documents/siteVisitorDays/$(request.resource.data.lastDayVisitId)).data.visitorId &&
        request.resource.data.updatedAt == request.time &&
        getAfter(/databases/$(database)/documents/siteVisitorDays/$(request.resource.data.lastDayVisitId)).data.createdAt == request.time;

      allow update: if
        dailyId.matches('^daily_[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.keys().hasOnly(['visitors','day','lastDayVisitId','updatedAt']) &&
        request.resource.data.visitors == resource.data.visitors + 1 &&
        request.resource.data.day == resource.data.day &&
        dailyId == 'daily_' + request.resource.data.day &&
        request.resource.data.lastDayVisitId is string &&
        request.resource.data.lastDayVisitId != resource.data.lastDayVisitId &&
        request.resource.data.lastDayVisitId == request.resource.data.day + '_' +
          getAfter(/databases/$(database)/documents/siteVisitorDays/$(request.resource.data.lastDayVisitId)).data.visitorId &&
        request.resource.data.updatedAt == request.time &&
        getAfter(/databases/$(database)/documents/siteVisitorDays/$(request.resource.data.lastDayVisitId)).data.createdAt == request.time;

      allow delete: if false;
    }
  }
}
